                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "critical": { "color": "red", "index": 0, "text": "CRITICAL" },
                      "warning": { "color": "#EAB839", "index": 1, "text": "WARNING" },
                      "info": { "color": "blue", "index": 2, "text": "INFO" }
                    },
                    "type": "value"
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
