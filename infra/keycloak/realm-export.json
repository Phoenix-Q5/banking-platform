{
  "realm": "banking",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Retail banking customer"
      },
      {
        "name": "ADMIN",
        "description": "Back-office / admin console user"
      },
      {
        "name": "SUPPORT",
        "description": "Contact-center support agent"
      }
    ]
  },
  "clients": [
    {
      "clientId": "banking-web",
      "publicClient": true,
      "enabled": true,
      "redirectUris": [
        "http://localhost:3001/*",
        "http://localhost:5173/*",
        "http://localhost:8085/*",
        "http://127.0.0.1:3001/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:8085/*"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "http://localhost:5173",
        "http://localhost:8085",
        "http://127.0.0.1:3001",
        "http://127.0.0.1:5173",
        "http://127.0.0.1:8085"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "banking-mobile",
      "publicClient": true,
      "enabled": true,
      "redirectUris": [
        "harborbank://callback",
        "com.harborbank.mobile://callback"
      ],
      "webOrigins": [
        "*"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "description": "Harbor Bank iOS / mobile banking client"
    },
    {
      "clientId": "banking-service-client",
      "publicClient": false,
      "secret": "change-me-in-a-real-deployment",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "description": "Client-credentials client for service-to-service calls (customer registration, ops tooling)"
    }
  ],
  "users": [
    {
      "username": "service-account-banking-service-client",
      "enabled": true,
      "serviceAccountClientId": "banking-service-client",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "demo.customer",
      "enabled": true,
      "email": "demo.customer@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Customer",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ]
    },
    {
      "username": "demo.admin",
      "enabled": true,
      "email": "demo.admin@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "SUPPORT"
      ]
    },
    {
      "username": "demo.support",
      "enabled": true,
      "email": "demo.support@example.com",
      "emailVerified": true,
      "firstName": "Casey",
      "lastName": "Support",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "SUPPORT"
      ]
    }
  ]
}
